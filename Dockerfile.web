# The installable web app. Build from the repo root:
#   docker build -f Dockerfile.web --build-arg NEXT_PUBLIC_DIRECTORY_URL=... --build-arg NEXT_PUBLIC_API_URLS=... .
FROM node:22-slim AS build
ARG NEXT_PUBLIC_DIRECTORY_URL
ARG NEXT_PUBLIC_API_URLS
ENV NEXT_PUBLIC_DIRECTORY_URL=${NEXT_PUBLIC_DIRECTORY_URL} \
    NEXT_PUBLIC_API_URLS=${NEXT_PUBLIC_API_URLS} \
    NEXT_TELEMETRY_DISABLED=1
WORKDIR /repo
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile --filter "@claimtidy/web..."
RUN pnpm --filter @claimtidy/web build

FROM node:22-slim
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0
WORKDIR /app
COPY --from=build /repo/apps/web/.next/standalone ./
COPY --from=build /repo/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
